<%- include('../partials/header', { title, libraryStyles }) %>
<%- include('../partials/navbar') %>

<main class="main-content library-content">
  <div class="library-container">
    <%- include('../partials/library-nav', { activeTab: 'search' }) %>

    <section class="library-hero">
      <div>
        <p class="library-eyebrow">F2.1 · SEARCH BOOKS (WHERE)</p>
        <h1 class="page-title">Search Books</h1>
        <p class="page-subtitle">Filter by title keyword, price range, and category. Results are sorted cheapest first.</p>
      </div>
      <div>
        <span class="bonus-tag" title="Bonus requirement fulfilled">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
          </svg>
          Bonus: Prepared Statements (Placeholders)
        </span>
      </div>
    </section>

    <!-- Search Filter Form -->
    <section class="card library-search-card">
      <form action="/library/search" method="GET" class="search-form">
        <div class="search-form-grid">
          <div class="form-group">
            <label for="title" class="form-label">Title Keyword (LIKE)</label>
            <input 
              type="text" 
              id="title" 
              name="title" 
              class="form-input" 
              placeholder="e.g. Walk, Palace, Egypt..." 
              value="<%= query.title || '' %>"
            >
          </div>

          <div class="form-group">
            <label for="min_price" class="form-label">Min Price ($)</label>
            <input 
              type="number" 
              step="0.01" 
              min="0" 
              id="min_price" 
              name="min_price" 
              class="form-input" 
              placeholder="0.00" 
              value="<%= query.min_price || '' %>"
            >
          </div>

          <div class="form-group">
            <label for="max_price" class="form-label">Max Price ($)</label>
            <input 
              type="number" 
              step="0.01" 
              min="0" 
              id="max_price" 
              name="max_price" 
              class="form-input" 
              placeholder="50.00" 
              value="<%= query.max_price || '' %>"
            >
          </div>

          <div class="form-group">
            <label for="category_id" class="form-label">Category</label>
            <select id="category_id" name="category_id" class="form-select">
              <option value="all" <%= (!query.category_id || query.category_id === 'all') ? 'selected' : '' %>>All Categories</option>
              <% categories.forEach(function(cat) { %>
                <option value="<%= cat.category_id %>" <%= query.category_id == cat.category_id ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
              <% }); %>
            </select>
          </div>
        </div>

        <div class="search-form-actions">
          <button type="submit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            Search Books
          </button>
          <a href="/library/search" class="btn btn-outline">Reset Filter</a>
        </div>
      </form>
    </section>

    <!-- Search Results -->
    <section class="card library-section" aria-labelledby="results-heading">
      <div class="library-section-heading">
        <div>
          <p class="library-eyebrow">QUERY RESULTS · CHEAPEST FIRST</p>
          <h2 id="results-heading">Matching Books <span class="library-count"><%= books.length %></span></h2>
        </div>
        <% if (executedQuery) { %>
          <div class="sql-code-pill" title="Prepared Statement used">
            <code><%= executedQuery %></code>
          </div>
        <% } %>
      </div>

      <% if (books.length) { %>
        <div class="library-table-wrap">
          <table class="library-table">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Book Title</th>
                <th scope="col">Author</th>
                <th scope="col">Publisher</th>
                <th scope="col">Category</th>
                <th scope="col">Year</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              <% books.forEach(function(book) { %>
                <tr>
                  <td><span class="library-id">#<%= book.book_id %></span></td>
                  <td class="library-book-title">
                    <div class="library-image-cell">
                      <% if (book.cover_image) { %>
                        <img class="library-thumbnail library-cover" src="/uploads/library/<%= book.cover_image %>" alt="Cover of <%= book.title %>">
                      <% } else { %>
                        <span class="library-image-placeholder" aria-hidden="true">BOOK</span>
                      <% } %>
                      <strong><%= book.title %></strong>
                    </div>
                  </td>
                  <td><%= book.author_name %></td>
                  <td><%= book.publisher_name %></td>
                  <td><span class="library-category-badge"><%= book.category_name %></span></td>
                  <td><%= book.publish_year || '—' %></td>
                  <td><strong class="price-highlight">$<%= Number(book.price).toFixed(2) %></strong></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="library-empty">No books matched your search criteria. Try broadening your keywords or price range.</p>
      <% } %>
    </section>
  </div>
</main>

<%- include('../partials/footer') %>
